# Published release artifacts are byte-bound by receipts and must not be line-ending converted.
releases/choice-atelier-v1.0.0/* -text
forschung/pi-treffpunkte/data/public-model.json -text
# Keep existing Brightcast caption bytes identical to the recorded release manifest.
assets/brightcast/*.vtt -text
assets/brightcast/*.srt -text
# Preserve upstream shader strings and licence bytes in the generated bundle.
forschung/morrowind-lernwelt/vendor/runtime.mjs -text -whitespace
forschung/morrowind-lernwelt/vendor/*.LICENSE.txt -text -whitespace
forschung/ashbound/vendor/runtime.mjs -text -whitespace
forschung/ashbound/vendor/*.LICENSE.txt -text -whitespace
# Poly Haven glTF JSON is byte-bound by the asset manifest on all platforms.
forschung/ashbound/play/assets/models/*/*.gltf -text

# Preserve the byte-bound public DE anchor artifact on every checkout.
forschung/de-anker-hela/public-monologue.md -text

# Keep the public JURI-THESIS brief byte-identical and review it as an artifact.
forschung/juri-thesis/assets/*.pdf binary
forschung/microvalue/*.pdf binary

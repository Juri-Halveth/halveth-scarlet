{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juri-halveth.github.io/halveth-scarlet/entities/ENTITY_CONTRACT_V2.schema.json",
  "title": "HALVETH research contribution, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "raw_seed", "meaning", "status", "capabilities", "state", "relations", "sources", "artifacts", "tests", "output", "falsifier", "next_seed"],
  "properties": {
    "schema": {"const": "halveth.entity-research.v2"},
    "id": {"type": "string", "pattern": "^research-[a-z0-9-]+$"},
    "raw_seed": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "sourceId", "originalRetention", "originalUserWording"],
      "properties": {
        "state": {"const": "DERIVED_FROM_SUPPLIED_SUMMARY"},
        "sourceId": {"type": "string", "minLength": 1},
        "originalRetention": {"const": "LOCAL_ORIGINAL_ARCHIVE"},
        "originalUserWording": {"const": "NOT_ASSERTED"}
      }
    },
    "meaning": {
      "type": "object", "additionalProperties": false, "required": ["text", "state"],
      "properties": {"text": {"type": "string", "minLength": 1}, "state": {"const": "EDITORIAL_NOT_USER_CONFIRMED"}}
    },
    "status": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "codePath", "experiment", "output"], "properties": {"kind": {"enum": ["LOCAL_EXECUTABLE_MODEL", "SOURCE_NAVIGATION"]}, "codePath": {"type": ["string", "null"]}, "experiment": {"enum": ["pulsar", "growth", "waves", null]}, "output": {"type": "string", "minLength": 1}}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["modelVersion", "scope"], "properties": {"modelVersion": {"type": ["string", "null"]}, "scope": {"type": "string", "minLength": 1}}},
    "relations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tests": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output": {"type": "string", "minLength": 1},
    "falsifier": {"type": "string", "minLength": 1},
    "next_seed": {"type": "string", "minLength": 1}
  }
}
